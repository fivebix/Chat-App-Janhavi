    "cors": "^2.8.6",
    "dotenv": "^16.4.1",
    "emoji-picker-react": "^4.22.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.3"
  }
